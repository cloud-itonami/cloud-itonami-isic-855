;; testadmn_supervisor_seated_elsewhere_test — HARD CHECK 34: no schedule-declared
;; supervisor seated as a test-taker of another registered session at the same
;; instant.
;;
;; ISIC-855 a test-taker seated in one room cannot simultaneously supervise
;; another. HARD CHECK 26 kept one test-taker out of two simultaneous exams,
;; HARD CHECK 28 kept one proctor out of two supervision plans, and HARD CHECK
;; 30 kept the target's own roster off its own supervision plan — but the cross
;; route was never bound: a :schedule-test-session declaring supervising staff
;; who are enrolled test-takers of a DIFFERENT registered session at the same
;; instant passed checks 1-33. HARD CHECK 34 rejects it outright — never held,
;; never auto-committed at Phase 3.

(ns testadmn-supervisor-seated-elsewhere-test
  (:require [clojure.test :refer [deftest is testing]]
            [testadmn.store :as store]
            [testadmn.governor :as gov]
            [testadmn.operation :as op]))

(defn- schedule-proposal
  [session-id & {:keys [supervision] :or {supervision ["P. Okafor"]}}]
  {:testadmn.proposal/id (str "sse-" session-id)
   :testadmn.proposal/type :schedule-test-session
   :testadmn.proposal/effect :propose
   :testadmn.proposal/target-session-id session-id
   :testadmn.proposal/proposal-data
   {:room "Gym A" :proctors 3 :proctor-supervision supervision}})

(defn- base-store
  "sess-001 registered @ 2026-07-15T09:00:00Z, roster #{s001 s002 P. Okafor}
   and NO supervision declared. P. Okafor is seated as a test-taker there. The
   caller decides the registered sibling sess-002."
  []
  (let [s (store/new-mem-store)]
    (store/register-session! s "sess-001"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s001" "s002" "P. Okafor"}})
    s))

(defn- check34 [result]
  (some #(when (contains? #{"not-a-schedule"
                            "schedule-start-time-unasserted"
                            "schedule-supervision-unasserted"
                            "schedule-proctor-seated-elsewhere"
                            "schedule-proctor-seating-free"}
                          (:reason %))
           %)
        (:checks result)))

(deftest test-staff-off-every-roster-passes
  ;; The target declares D. Reyes, who is NOT an enrolled test-taker of any
  ;; registered session at that instant: the schedule commits cleanly.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "ACT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002" :supervision ["D. Reyes"]))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result)))
      (is (= "schedule-proctor-seating-free" (:reason (check34 result)))))))

(deftest test-supervisor-seated-elsewhere-rejected
  ;; sess-002 starts at the SAME instant as sess-001 and declares P. Okafor,
  ;; who is an ENROLLED test-taker of sess-001: a seated examinee cannot
  ;; supervise another room — rejected, with the collision partner and the
  ;; shared person named.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Retake Annex 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))
          c (check34 result)]
      (is (false? (:accepted? result)))
      (is (= "schedule-proctor-seated-elsewhere" (:reason result)))
      (is (= "sess-002" (:session-id c)))
      (is (= "2026-07-15T09:00:00Z" (:scheduled-start c)))
      (is (= [{:session "sess-001" :proctors ["P. Okafor"]}] (:collisions c))))))

(deftest test-same-person-at-different-times-is-fine
  ;; A person may take the morning exam and supervise the afternoon one: the
  ;; seating collision is only against sessions at the SAME instant.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Afternoon 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T13:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-unregistered-twin-seats-nobody
  ;; A session sharing the instant and the person but NOT registered cannot
  ;; seat them: only registered sessions block staff.
  (let [s (store/new-mem-store)]
    (store/create-session! s "twin-draft"
      {:testadmn.test-session/name "Draft twin"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"P. Okafor"}})
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s001" "s002"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-time-less-target-defers-vacuously
  ;; A blank start on the target yields no instant key, so check 34 defers;
  ;; the schedule route's start-time binding is check 12's decision.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "Time-less twin"
       :testadmn.test-session/scheduled-start ""
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
      (is (= "schedule-start-time-unasserted" (:reason (check34 result)))))))

(deftest test-unasserted-supervision-passes-vacuously
  ;; A schedule that names NO supervising staff asserts no body check 34
  ;; could seat-elsewhere: the headcount sufficiency is check 27's decision.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Annex 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002" :supervision []))]
      (is (= "schedule-supervision-unasserted" (:reason (check34 result)))))))

(deftest test-non-schedule-op-passes-trivially
  ;; HARD CHECK 34 binds only :schedule-test-session.
  (let [s (base-store)
        proposal {:testadmn.proposal/id "sse-att"
                  :testadmn.proposal/type :log-attendance-note
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.proposal/proposal-data
                  {:check-in [] :absent []}}
        result (gov/evaluate-proposal s proposal)]
    (is (= "not-a-schedule" (:reason (check34 result))))))

(deftest test-seating-collision-never-auto-commits-phase3
  ;; End to end at Phase 3: the colliding supervision plan is rejected, never
  ;; auto-committed.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Retake Annex 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [operation (op/make-operation :schedule-test-session "sess-002"
                                       {:room "Gym B" :proctors 2
                                        :proctor-supervision ["P. Okafor"]})
          result (op/execute-operation operation s 3)]
      (is (= :rejected (:status result)))
      (is (= "schedule-proctor-seated-elsewhere" (:reason result))))))

(deftest test-check8-still-last-after-check34
  ;; HARD CHECK 8 stays the LAST entry of the governor's :checks vector, so
  ;; testadmn_integrity_test's (last :checks) contract keeps holding after
  ;; HARD CHECK 34 is added.
  (let [s (base-store)
        proposal {:testadmn.proposal/id "sse-34b"
                  :testadmn.proposal/type :log-attendance-note
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.proposal/proposal-data
                  {:check-in [] :absent []}}
        result (gov/evaluate-proposal s proposal)
        check8 (last (:checks result))]
    (is (= "attendance-non-contradictory" (:reason check8)))))

(deftest test-seating-collision-parity-across-backends
  ;; The roster-overlap check reads the same on the Datomic-backed store: the
  ;; roster set round-trips (flattened from the nested set blob) and still
  ;; trips check 34.
  (doseq [[make-store label] [[store/new-mem-store "MemStore"]
                              [store/new-datomic-store "DatomicStore"]]]
    (testing label
      (let [s (make-store)]
        (store/register-session! s "sess-001"
          {:testadmn.test-session/name "SAT Administration 2026-07-15"
           :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
           :testadmn.test-session/facility-id "facility-101"
           :testadmn.test-session/roster #{"s001" "s002" "P. Okafor"}})
        (store/register-session! s "sess-002"
          {:testadmn.test-session/name "SAT Retake Annex 2026-07-15"
           :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
           :testadmn.test-session/facility-id "facility-204"
           :testadmn.test-session/roster #{"s003" "s004"}})
        (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
          (is (false? (:accepted? result)))
          (is (= "schedule-proctor-seated-elsewhere" (:reason result)))
          (is (= [{:session "sess-001" :proctors ["P. Okafor"]}]
                 (:collisions (check34 result)))))))))
