;; testadmn_schedule_interval_test — HARD CHECK 40: no room-interval overlap.
;;
;; ISIC-855 one room is occupied for a WINDOW, not an instant. HARD CHECK 25
;; keeps two exams out of the same room at the same start instant, but sessions
;; have duration: a 09:00-11:00 exam in facility-101 and a 10:00-12:00 exam in
;; facility-101 never share a start instant, so check 25 never fires, yet the
;; room is double-booked from 10:00 — a conflict that surfaces only when the
;; second session's test-takers walk into an exam already in progress. HARD
;; CHECK 40 rejects it outright — never held, never auto-committed at Phase 3.

(ns testadmn-schedule-interval-test
  (:require [clojure.test :refer [deftest is testing]]
            [testadmn.store :as store]
            [testadmn.governor :as gov]
            [testadmn.operation :as op]))

(defn- schedule-proposal [session-id]
  {:testadmn.proposal/id (str "iv-" session-id)
   :testadmn.proposal/type :schedule-test-session
   :testadmn.proposal/effect :propose
   :testadmn.proposal/target-session-id session-id
   :testadmn.proposal/proposal-data {:room "Gym A" :proctors 3}})

(defn- occupied-interval-store
  "A store where sess-001 is fully scheduled/registered in facility-101 with
   the 09:00-11:00 window asserted, and sess-002 is a registered, venued,
   start-ed, rostered sibling whose window the caller decides."
  []
  (let [s (store/new-mem-store)]
    (store/register-session! s "sess-001"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T11:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s001" "s002"}})
    s))

(deftest test-non-overlapping-window-in-same-room-passes
  ;; sess-002 sits in the SAME room but AFTER sess-001's window ends — the
  ;; room is free again, so the schedule passes cleanly.
  (let [s (occupied-interval-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "ACT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T11:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T13:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s003"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-same-instant-same-room-still-collides-via-check25-first
  ;; A sibling window that starts exactly at the target's start is the
  ;; check-25 instant collision; the reason chain reports check 25's reason
  ;; (it is earlier in the :checks vector), not the interval overlap.
  (let [s (occupied-interval-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Retake 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T10:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
      (is (false? (:accepted? result)))
      (is (= "schedule-venue-time-collision" (:reason result))))))

(deftest test-partial-window-overlap-in-same-room-rejected
  ;; sess-002 starts 10:00 — inside sess-001's 09:00-11:00 window but at a
  ;; DIFFERENT start instant, so check 25 never fires. Check 40 rejects the
  ;; interval double-booking with the colliding sibling named.
  (let [s (occupied-interval-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Midday 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T10:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T12:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))
          check40 (some #(when (= "schedule-interval-overlap" (:reason %)) %)
                        (:checks result))]
      (is (false? (:accepted? result)))
      (is (= "schedule-interval-overlap" (:reason result)))
      (is (= "sess-002" (:session-id check40)))
      (is (= [{:session "sess-001"
               :window ["2026-07-15T09:00:00Z" "2026-07-15T11:00:00Z"]}]
             (:collisions check40)))
      (is (= ["2026-07-15T10:00:00Z" "2026-07-15T12:00:00Z"] (:window check40))))))

(deftest test-overlap-in-a-different-room-passes
  ;; The window dimension binds per ROOM: an overlapping window in another
  ;; facility is not a room conflict (person collisions are checks 26/34).
  (let [s (occupied-interval-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "ACT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T10:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T12:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{"s003"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-unasserted-end-passes-vacuously
  ;; A target with no :scheduled-end claims no window: check 12 binds its
  ;; venue/start presence and check 25 binds the instant — the interval check
  ;; passes vacuously, preserving every pre-existing end-less schedule.
  (let [s (occupied-interval-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "Legacy Windowless Scheduling"
       :testadmn.test-session/scheduled-start "2026-07-15T10:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s003"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))
          check40 (some #(when (contains? #{"schedule-end-time-unasserted"
                                            "schedule-interval-free"}
                                          (:reason %)) %)
                        (:checks result))]
      (is (true? (:accepted? result)))
      (is (= "schedule-end-time-unasserted" (:reason check40))))))

(deftest test-unregistered-twin-window-does-not-occupy
  ;; Only REGISTERED sessions occupy a window: an unregistered draft twin
  ;; parked in the same room/window cannot block the target's schedule.
  (let [s (store/new-mem-store)]
    (store/create-session! s "twin-draft"
      {:testadmn.test-session/name "Draft twin"
       :testadmn.test-session/scheduled-start "2026-07-15T10:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T12:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s009"}})
    (store/register-session! s "sess-001"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T11:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s001" "s002"}})
    (let [result (gov/evaluate-proposal s (schedule-proposal "sess-001"))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-non-schedule-op-unaffected-by-interval-check
  ;; HARD CHECK 40 applies only to :schedule-test-session. An attendance note
  ;; inside an occupied window passes trivially.
  (let [s (occupied-interval-store)
        proposal {:testadmn.proposal/id "iv-att"
                  :testadmn.proposal/type :log-attendance-note
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.proposal/proposal-data
                  {:check-in ["s001" "s002"]}}
        result (gov/evaluate-proposal s proposal)
        check40 (some #(when (contains? #{"not-a-schedule"
                                          "schedule-interval-overlap"
                                          "schedule-interval-free"
                                          "schedule-end-time-unasserted"}
                                        (:reason %))
                         %)
                      (:checks result))]
    (is (true? (:accepted? result)))
    (is (= "not-a-schedule" (:reason check40)))))

(deftest test-interval-overlap-never-auto-commits-phase3
  ;; End to end at Phase 3: the interval-colliding schedule is rejected,
  ;; never auto-committed two overlapping exams into one room.
  (let [s (occupied-interval-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Midday 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T10:00:00Z"
       :testadmn.test-session/scheduled-end "2026-07-15T12:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s003" "s004"}})
    (let [operation (op/make-operation :schedule-test-session "sess-002"
                                        {:room "Gym A" :proctors 3})
          result (op/execute-operation operation s 3)]
      (is (= :rejected (:status result)))
      (is (= "schedule-interval-overlap" (:reason result))))))

(deftest test-check8-still-last-after-check40
  ;; HARD CHECK 8 stays the LAST entry of the governor's :checks vector, so
  ;; testadmn_integrity_test's (last :checks) contract keeps holding after
  ;; HARD CHECK 40 is added.
  (let [s (occupied-interval-store)
        proposal {:testadmn.proposal/id "iv-40b"
                  :testadmn.proposal/type :log-attendance-note
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.test-session/note nil
                  :testadmn.proposal/proposal-data
                  {:check-in ["s001"] :absent ["s002"]}}
        result (gov/evaluate-proposal s proposal)
        check8 (last (:checks result))]
    (is (= "attendance-non-contradictory" (:reason check8)))))

(deftest test-interval-check-parity-across-backends
  ;; The interval collision is detected identically on the Datomic-backed
  ;; store: both backends satisfy list-sessions and the same rejection.
  (doseq [[make-store label] [[store/new-mem-store "MemStore"]
                              [store/new-datomic-store "DatomicStore"]]]
    (testing label
      (let [s (make-store)]
        (store/register-session! s "sess-001"
          {:testadmn.test-session/name "SAT Administration 2026-07-15"
           :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
           :testadmn.test-session/scheduled-end "2026-07-15T11:00:00Z"
           :testadmn.test-session/facility-id "facility-101"
           :testadmn.test-session/roster #{"s001" "s002"}})
        (store/register-session! s "sess-002"
          {:testadmn.test-session/name "SAT Midday 2026-07-15"
           :testadmn.test-session/scheduled-start "2026-07-15T10:00:00Z"
           :testadmn.test-session/scheduled-end "2026-07-15T12:00:00Z"
           :testadmn.test-session/facility-id "facility-101"
           :testadmn.test-session/roster #{"s003"}})
        (let [result (gov/evaluate-proposal s (schedule-proposal "sess-002"))]
          (is (false? (:accepted? result)))
          (is (= "schedule-interval-overlap" (:reason result)))
          (is (= 2 (count (store/list-sessions s)))))))))
