;; testadmn_supervision_self_roster_test — HARD CHECK 30: no self-supervision
;; of the target's own enrolled roster.
;;
;; ISIC-855 a proctor supervises the EXAMINEES, never sits among them. HARD
;; CHECK 21 closed the assignment side (:coordinate-proctor-assignment-proposal
;; must not name an enrolled test-taker), but the scheduling side was never
;; bound: a :schedule-test-session's :proctor-supervision ids were never
;; compared with the target's OWN roster. HARD CHECK 30 rejects the overlap
;; outright — never held, never auto-committed at Phase 3.

(ns testadmn-supervision-self-roster-test
  (:require [clojure.test :refer [deftest is testing]]
            [testadmn.store :as store]
            [testadmn.governor :as gov]
            [testadmn.operation :as op]))

(defn- schedule-proposal
  [session-id & {:keys [supervision] :or {supervision ["P. Okafor" "L. Marsh"]}}]
  {:testadmn.proposal/id (str "ssr-" session-id)
   :testadmn.proposal/type :schedule-test-session
   :testadmn.proposal/effect :propose
   :testadmn.proposal/target-session-id session-id
   :testadmn.proposal/proposal-data
   {:room "Gym A" :proctors 3 :proctor-supervision supervision}})

(defn- base-store
  "sess-001 registered @ 2026-07-15T09:00:00Z with roster #{s001 s002 s003}
   and supervision #{P. Okafor L. Marsh} -- the declared staff are NOT on the
   roster, so the baseline schedule passes."
  []
  (let [s (store/new-mem-store)]
    (store/register-session! s "sess-001"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{"s001" "s002" "s003"}
       :testadmn.test-session/supervision #{"P. Okafor" "L. Marsh"}})
    s))

(defn- check30 [result]
  (some #(when (contains? #{"not-a-schedule"
                            "schedule-proctor-not-enrolled"
                            "schedule-self-supervision"}
                          (:reason %))
           %)
        (:checks result)))

(deftest test-disjoint-supervision-passes
  ;; Declared staff are off-roster: the baseline case, and every op other
  ;; than :schedule-test-session passes trivially.
  (let [s (base-store)
        result (gov/evaluate-proposal s (schedule-proposal "sess-001"))]
    (is (true? (:accepted? result)))
    (is (= "all-checks-pass" (:reason result)))
    (is (= "schedule-proctor-not-enrolled" (:reason (check30 result))))))

(deftest test-enrolled-taker-as-own-proctor-rejected
  ;; s001 is BOTH on sess-001's roster and named as its supervisor: a seated
  ;; examinee watches their own exam -- rejected, with the shared id named.
  (let [s (base-store)
        result (gov/evaluate-proposal s (schedule-proposal "sess-001"
                                              :supervision ["s001" "P. Okafor"]))
        c (check30 result)]
    (is (false? (:accepted? result)))
    (is (= "schedule-self-supervision" (:reason result)))
    (is (= "sess-001" (:session-id c)))
    (is (= ["s001"] (:proctors c)))))

(deftest test-other-op-passes-trivially
  ;; HARD CHECK 30 binds only :schedule-test-session; another op naming ids
  ;; that happen to overlap a roster is a different chain's decision.
  (let [s (base-store)
        result (gov/evaluate-proposal s
                 {:testadmn.proposal/id "ssr-other-op"
                  :testadmn.proposal/type :coordinate-supply-request
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.proposal/proposal-data
                  {:items ["pencils"]}})]
    (is (true? (:accepted? result)))
    (is (= "not-a-schedule" (:reason (check30 result))))))
