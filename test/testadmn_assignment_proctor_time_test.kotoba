;; testadmn_assignment_proctor_time_test — HARD CHECK 31: no proctor-assignment
;; time collision across simultaneous sessions.
;;
;; ISIC-855 one staff member supervises ONE exam at a time, no matter which
;; route the paperwork took. HARD CHECK 28 bound the schedule route; the
;; assignment route (:coordinate-proctor-assignment-proposal) was never
;; compared against the population: naming a proctor who is already another
;; registered session's supervising staff at the target's own
;; :scheduled-start passed checks 1-30. HARD CHECK 31 rejects it outright —
;; never held, never auto-committed at Phase 3.

(ns testadmn-assignment-proctor-time-test
  (:require [clojure.test :refer [deftest is testing]]
            [testadmn.store :as store]
            [testadmn.governor :as gov]
            [testadmn.operation :as op]))

(defn- pa-proposal
  [session-id proctor-ids]
  {:testadmn.proposal/id (str "apt-" session-id)
   :testadmn.proposal/type :coordinate-proctor-assignment-proposal
   :testadmn.proposal/effect :propose
   :testadmn.proposal/target-session-id session-id
   :testadmn.proposal/proposal-data
   {:proctors (mapv (fn [p] {:proctor/id p
                             :testadmn.proposal/proctor-impartial? true})
                    proctor-ids)}})

(defn- base-store
  "sess-001 registered @ 2026-07-15T09:00:00Z with supervision
   #{P. Okafor L. Marsh} — P. Okafor is busy at that instant. The caller
   decides the registered sibling sess-002."
  []
  (let [s (store/new-mem-store)]
    (store/register-session! s "sess-001"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{}
       :testadmn.test-session/supervision #{"P. Okafor" "L. Marsh"}})
    s))

(defn- check31 [result]
  (some #(when (contains? #{"not-a-proctor-assignment"
                            "assignment-start-time-unasserted"
                            "assignment-proctors-unasserted"
                            "assignment-proctor-time-collision"
                            "assignment-proctor-time-free"}
                          (:reason %))
           %)
        (:checks result)))

(deftest test-disjoint-proctors-at-same-instant-passes
  ;; The target assigns D. Reyes, who is NOT supervising any registered
  ;; session at that instant: the assignment commits cleanly.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "ACT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{}})
    (let [result (gov/evaluate-proposal s (pa-proposal "sess-002" ["D. Reyes"]))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result)))
      (is (= "assignment-proctor-time-free" (:reason (check31 result)))))))

(deftest test-shared-proctor-at-same-instant-rejected
  ;; sess-002 starts at the SAME instant as sess-001 and assigns P. Okafor,
  ;; already sess-001's supervising staff: one body cannot serve two rooms —
  ;; rejected, with the collision partner and the shared staff member named.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Retake Annex 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{}})
    (let [result (gov/evaluate-proposal s (pa-proposal "sess-002" ["P. Okafor"]))
          c (check31 result)]
      (is (false? (:accepted? result)))
      (is (= "assignment-proctor-time-collision" (:reason result)))
      (is (= "sess-002" (:session-id c)))
      (is (= "2026-07-15T09:00:00Z" (:scheduled-start c)))
      (is (= [{:session "sess-001" :proctors ["P. Okafor"]}] (:collisions c))))))

(deftest test-same-proctor-at-different-times-is-fine
  ;; A staff member legitimately supervises a morning and an afternoon exam:
  ;; the collision is only against sessions at the SAME instant.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Afternoon 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T13:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{}})
    (let [result (gov/evaluate-proposal s (pa-proposal "sess-002" ["P. Okafor"]))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-unregistered-twin-shares-no-proctors
  ;; A session sharing the instant and the staff member but NOT registered
  ;; cannot occupy a supervisor: only registered sessions block staff time.
  (let [s (store/new-mem-store)]
    (store/create-session! s "twin-draft"
      {:testadmn.test-session/name "Draft twin"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/supervision #{"P. Okafor"}})
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Administration 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-101"
       :testadmn.test-session/roster #{}})
    (let [result (gov/evaluate-proposal s (pa-proposal "sess-002" ["P. Okafor"]))]
      (is (true? (:accepted? result)))
      (is (= "all-checks-pass" (:reason result))))))

(deftest test-time-less-target-defers-vacuously
  ;; A blank start on the target yields no instant key, so check 31 defers;
  ;; the schedule route's start-time binding is check 12's decision.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "Time-less twin"
       :testadmn.test-session/scheduled-start ""
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{}})
    (let [result (gov/evaluate-proposal s (pa-proposal "sess-002" ["P. Okafor"]))]
      (is (true? (:accepted? result)))
      (is (= "assignment-start-time-unasserted" (:reason (check31 result)))))))

(deftest test-non-assignment-op-passes-trivially
  ;; HARD CHECK 31 binds only :coordinate-proctor-assignment-proposal.
  (let [s (base-store)
        proposal {:testadmn.proposal/id "apt-att"
                  :testadmn.proposal/type :log-attendance-note
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.proposal/proposal-data
                  {:check-in [] :absent []}}
        result (gov/evaluate-proposal s proposal)]
    (is (= "not-a-proctor-assignment" (:reason (check31 result))))))

(deftest test-assignment-collision-never-auto-commits-phase3
  ;; End to end at Phase 3: the colliding assignment is rejected, never
  ;; auto-committed.
  (let [s (base-store)]
    (store/register-session! s "sess-002"
      {:testadmn.test-session/name "SAT Retake Annex 2026-07-15"
       :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
       :testadmn.test-session/facility-id "facility-204"
       :testadmn.test-session/roster #{}})
    (let [operation (op/make-operation :coordinate-proctor-assignment-proposal
                                       "sess-002"
                                       {:proctors [{:proctor/id "P. Okafor"
                                                    :testadmn.proposal/proctor-impartial? true}]})
          result (op/execute-operation operation s 3)]
      (is (= :rejected (:status result)))
      (is (= "assignment-proctor-time-collision" (:reason result))))))

(deftest test-check8-still-last-after-check31
  ;; HARD CHECK 8 stays the LAST entry of the governor's :checks vector, so
  ;; testadmn_integrity_test's (last :checks) contract keeps holding after
  ;; HARD CHECK 31 is added.
  (let [s (base-store)
        proposal {:testadmn.proposal/id "apt-31b"
                  :testadmn.proposal/type :log-attendance-note
                  :testadmn.proposal/effect :propose
                  :testadmn.proposal/target-session-id "sess-001"
                  :testadmn.proposal/proposal-data
                  {:check-in [] :absent []}}
        result (gov/evaluate-proposal s proposal)
        check8 (last (:checks result))]
    (is (= "attendance-non-contradictory" (:reason check8)))))

(deftest test-assignment-collision-parity-across-backends
  ;; The assignment-time-overlap check reads the same on the Datomic-backed
  ;; store: the supervision set round-trips and still trips check 31.
  (doseq [[make-store label] [[store/new-mem-store "MemStore"]
                              [store/new-datomic-store "DatomicStore"]]]
    (testing label
      (let [s (make-store)]
        (store/register-session! s "sess-001"
          {:testadmn.test-session/name "SAT Administration 2026-07-15"
           :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
           :testadmn.test-session/facility-id "facility-101"
           :testadmn.test-session/roster #{}
           :testadmn.test-session/supervision #{"P. Okafor" "L. Marsh"}})
        (store/register-session! s "sess-002"
          {:testadmn.test-session/name "SAT Retake Annex 2026-07-15"
           :testadmn.test-session/scheduled-start "2026-07-15T09:00:00Z"
           :testadmn.test-session/facility-id "facility-204"
           :testadmn.test-session/roster #{}})
        (let [result (gov/evaluate-proposal s (pa-proposal "sess-002" ["P. Okafor"]))]
          (is (false? (:accepted? result)))
          (is (= "assignment-proctor-time-collision" (:reason result)))
          (is (= [{:session "sess-001" :proctors ["P. Okafor"]}]
                 (:collisions (check31 result)))))))))
