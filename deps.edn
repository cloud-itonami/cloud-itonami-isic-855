{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain/langchain-store to local checkouts.
  ;; (previously: top-level :deps used :local/root directly for langgraph-clj AND
  ;; langchain-store, which only resolves inside this exact monorepo layout and used a
  ;; stale pre-rename artifact id `com-junkawasaki/langgraph-clj` -- neither the fleet-
  ;; standard shape nor actually standalone-forkable. langchain-store is not currently
  ;; used by src/testadmn/store.cljc's actual code (the `ls` alias is imported but
  ;; unreferenced) -- kept here as a :dev-only override so it stays available if/when
  ;; that wiring is finished, without forcing every consumer to resolve it.)
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}
        :extra-deps
        {io.github.kotoba-lang/langchain-store
         {:local/root "../../kotoba-lang/langchain-store"}}}
  :run {:main-opts ["-m" "testadmn.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
